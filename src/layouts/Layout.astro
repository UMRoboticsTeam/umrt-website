---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description =
    'University of Manitoba Robotics Team — robotics, competition, outreach, and student engineering.'
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    
    <title>{`UMRT — ${title}`}</title>
    <link rel="icon" href="/favicon.ico" />

    <meta name="description" content={description} />
    <meta property="og:title" content={`UMRT — ${title}`} />
    <meta property="og:description" content={description} />
    
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>