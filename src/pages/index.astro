---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Sponsors from '../components/Sponsors.astro';
import RoverPlaceholder from '../components/RoverPlaceholder.astro';
---

<Layout title="Home">
  <Hero imgSrc="/assets/teamphoto-2425-1.jpg">
    <p class="main-header1">University of Manitoba</p>
    <p class="main-header2">Robotics Team</p>
  </Hero>

  <Section
    theme="light"
    title="About Us"
    id="about"
  >
    <div class="prose">
      <p>
        The University of Manitoba Robotics Team (UMRT) is an ambitious
        group of students competing in the Canadian
        International Rover Challenge (CIRC) . Our disciplines range from
        Computer Vision, Mechanical Engineering, Electrical Engineering,
        Embedded Systems, Wireless Communications, and Pedology.
      </p>

      <p>
        We also plan workshops, open competitions, outreach events, and
        other activities that make robotics accessible to students.
      </p>

      <p>
        Contact <a href="mailto:exec.umrt@gmail.com">contact@umrt.ca</a> for questions or inquiries.
      </p>
    </div>
  </Section>

  <Section theme="primary">
    <RoverPlaceholder />
  </Section>

  <Section
    theme="dark"
    title="Competitions"
  >
    <div class="prose">
      <p>
        UMRT competes in the Canadian International Rover Competition
        (CIRC), held annually in Drumheller, Alberta.
      </p>

      <div class="actions">
        <a
          class="btn btn-light"
          href="/competitions"
        >
          View competitions
        </a>
      </div>
    </div>
  </Section>

  <Sponsors />
</Layout>

<style>
.main-header1 {

}
.main-header2 {

}
</style>