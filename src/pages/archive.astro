---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import PhotoShowcase from '../components/PhotoShowcase.astro';
import { Image } from 'astro:assets';

const archiveYears = (await getCollection('archive')).sort(
  (a, b) => b.data.year.localeCompare(a.data.year)
);
---

<Layout title="Archive" description="Historical team information and archives for UMRT.">
  <PageIntro
    title="Archive"
    image="/assets/images/TeamPhoto-2324.jpg"
  />

  {
    archiveYears.map((archive) => {
      const archiveDirectory = `archive/${archive.id.replace(/\/index$/, '')}/images`;

      return (
        <Section
          theme={archive.data.theme}
          title={archive.data.year}
        >
          <Image
            class="archive-photo"
            src={archive.data.mainPhoto}
            alt={`${archive.data.year} team photo`}
          />

          <div class="prose">
            <p>{archive.data.description}</p>
          </div>

          <div class="table-wrap" style="margin-top:2rem">
            <table>
              <thead />

              <tbody>
                {
                  archive.data.roles.map(({ role, member }) => (
                    <tr>
                      <th>{role}</th>
                      <td>{member}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <div class="prose" style="margin-top:2rem">
            <h3>Members</h3>
            <p>{archive.data.members.join(', ')}</p>
          </div>

          <PhotoShowcase directory={archiveDirectory} />
        </Section>
      );
    })
  }
</Layout>

<style>
.archive-photo {
  display: block;
  width: 100%;
  /* max-width: 650px; */
  max-height: 300px;
  height: auto;
  margin: 0 auto 1.5rem;
  border-radius: 12px;
  object-fit: cover;
}

.prose {
  line-height: 1.45;
}

.prose p {
  margin-top: 0;
  margin-bottom: 0;
}

.prose h3 {
  margin-bottom: 0.5rem;
}

.table-wrap {
  width: fit-content;
  max-width: 100%;
  margin-left: auto;
  margin-right: auto;
  overflow-x: auto;
}

.table-wrap table {
  width: auto;
  min-width: 360px;
  border-collapse: collapse;
}

.table-wrap th,
.table-wrap td {
  padding: 0 0.8rem;
  line-height: 1.25;
  white-space: nowrap;
}

.table-wrap th {
  text-align: left;
}
</style>