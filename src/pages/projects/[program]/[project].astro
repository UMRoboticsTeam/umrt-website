---
import type { CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/PageIntro.astro';
import Section from '@/components/Section.astro';
import ProjectExplorer from '@/components/ProjectExplorer.astro';
import { getPrograms, getProjects } from '@/lib/projects';

export async function getStaticPaths() {
  const [programs, projects] = await Promise.all([getPrograms(), getProjects()]);
  return projects.map((project) => ({
    params: { program: project.data.program.id, project: project.id },
    props: {
      project,
      program: programs.find((program) => program.id === project.data.program.id)!,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  program: CollectionEntry<'programs'>;
}

const { project, program } = Astro.props;
---

<Layout title="Projects" description="Explore UMRT's robotics programs and the designs behind our robots.">
  <PageIntro
    title="Projects"
    image={project.data.image}
  />

  <Section title="Explore Our Designs" theme="deep-blue" id="designs">
    <ProjectExplorer initialProgram={program.id} initialProject={project.id} />
  </Section>
</Layout>
