---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { sponsors } from '../content/sponsors/sponsors.ts';
---

<Section theme="light" title='Our Sponsors'>

  <div class="sponsor-list sponsor-list-high">
    {sponsors.high.map((sponsor) => (
      <div class="sponsor">
        {sponsor.href ? (
          <a
            href={sponsor.href}
            target="_blank"
            rel="noopener noreferrer"
            title={sponsor.name}
          >
            <Image src={sponsor.logo} alt={sponsor.name} />
          </a>
        ) : (
          <Image
            src={sponsor.logo}
            alt={sponsor.name}
            title={sponsor.name}
          />
        )}
      </div>
    ))}
  </div>

  <hr class="divider divider-light" />

  <div class="sponsor-list sponsor-list-med">
    {sponsors.med.map((sponsor) => (
      <div class="sponsor">
        {sponsor.href ? (
          <a
            href={sponsor.href}
            target="_blank"
            rel="noopener noreferrer"
            title={sponsor.name}
          >
            <Image src={sponsor.logo} alt={sponsor.name} />
          </a>
        ) : (
          <Image
            src={sponsor.logo}
            alt={sponsor.name}
            title={sponsor.name}
          />
        )}
      </div>
    ))}
  </div>

  <hr class="divider divider-light" />

  <div class="sponsor-list sponsor-list-low">
    {sponsors.low.map((sponsor) => (
      <div class="sponsor">
        {sponsor.href ? (
          <a
            href={sponsor.href}
            target="_blank"
            rel="noopener noreferrer"
            title={sponsor.name}
          >
            <Image src={sponsor.logo} alt={sponsor.name} />
          </a>
        ) : (
          <Image
            src={sponsor.logo}
            alt={sponsor.name}
            title={sponsor.name}
          />
        )}
      </div>
    ))}
  </div>
</Section>

<style>
.sponsor-list {
  padding: 10px;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 3.5rem;
}

.sponsor {
  flex: 0 0 calc(50% - 1.75rem);
}

.sponsor-list-med .sponsor {
  flex-basis: calc(25% - 2.625rem);
}

.sponsor-list-low .sponsor {
  flex-basis: calc(16.6667% - 2.9167rem);
}

.sponsor a {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
}

.sponsor img {
  max-width: 100%;
  max-height: 130px;
  width: auto;
  height: auto;
  object-fit: contain;
}

@media (max-width: 992px) {
.sponsor-list {
    gap: 2rem;
  }

  .sponsor-list-med .sponsor {
    flex-basis: calc(33.3333% - 1.3333rem);
  }

  .sponsor-list-low .sponsor {
    flex-basis: calc(25% - 1.5rem);
  }
}

@media (max-width: 576px) {
  .sponsor-list {
    gap: 1rem;
   }
}
</style>