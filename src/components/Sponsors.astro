---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { sponsors } from '../content/sponsors';
---

<Section theme="light" title='Our Sponsors'>

  <div class="sponsor-list sponsor-list-high">
    {sponsors.high.map((sponsor) => (
      <div class="sponsor">
        {sponsor.href ? (
          <a
            href={sponsor.href}
            target="_blank"
            rel="noopener noreferrer"
            title={sponsor.name}
          >
            <Image src={sponsor.logo} alt={sponsor.name} />
          </a>
        ) : (
          <Image
            src={sponsor.logo}
            alt={sponsor.name}
            title={sponsor.name}
          />
        )}
      </div>
    ))}
  </div>

  <hr class="divider divider-light" />

  <div class="sponsor-list sponsor-list-med">
    {sponsors.med.map((sponsor) => (
      <div class="sponsor">
        {sponsor.href ? (
          <a
            href={sponsor.href}
            target="_blank"
            rel="noopener noreferrer"
            title={sponsor.name}
          >
            <Image src={sponsor.logo} alt={sponsor.name} />
          </a>
        ) : (
          <Image
            src={sponsor.logo}
            alt={sponsor.name}
            title={sponsor.name}
          />
        )}
      </div>
    ))}
  </div>

  <hr class="divider divider-light" />

  <div class="sponsor-list sponsor-list-low">
    {sponsors.low.map((sponsor) => (
      <div class="sponsor">
        {sponsor.href ? (
          <a
            href={sponsor.href}
            target="_blank"
            rel="noopener noreferrer"
            title={sponsor.name}
          >
            <Image src={sponsor.logo} alt={sponsor.name} />
          </a>
        ) : (
          <Image
            src={sponsor.logo}
            alt={sponsor.name}
            title={sponsor.name}
          />
        )}
      </div>
    ))}
  </div>
</Section>

<style>
.sponsor-list {
  padding: 10px;
  display: grid;
  justify-content: center;
  align-items: center;
  gap: 3.5rem;
}

.sponsor-list-high {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.sponsor-list-med {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.sponsor-list-low {
  grid-template-columns: repeat(6, minmax(0, 1fr));
}

.sponsor {
  display: flex;
  justify-content: center;
  align-items: center;
  min-width: 0;
}

.sponsor a {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
}

.sponsor img {
  max-width: 100%;
  max-height: 130px;
  width: auto;
  height: auto;
  object-fit: contain;
}

@media (max-width: 992px) {
  .sponsor-list-med {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .sponsor-list-low {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
   .sponsor-list {
    gap: 2rem;
   }
}

@media (max-width: 576px) {
  .sponsor-list {
    gap: 1rem;
   }
}
</style>