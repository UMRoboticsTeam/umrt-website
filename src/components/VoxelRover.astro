<div class="voxel-wrapper">
  <div class="voxel-error" hidden>
    <div class="voxel-error-content">
      <h2>3D Graphics Unavailable</h2>
      <p>
        This device or browser does not support the graphics
        features required to display this animation.
      </p>
    </div>
  </div>

  <div class="voxel-container"></div>
</div>

<script>
import * as THREE from 'three';
import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';

const wrappers = document.querySelectorAll('.voxel-wrapper');

wrappers.forEach((wrapper) => {
  const threeCanvas = wrapper.querySelector('.voxel-container');
  const errorElement = wrapper.querySelector('.voxel-error');

  if (!threeCanvas || !errorElement) {
    return;
  }

  let scene = null;
  let camera = null;
  let renderer = null;
  let frameId = null;

  let rover1 = null;
  let rover2 = null;

  const environmentObjects = [];
  const particles = [];

  const scrollSpeed = 0.06;

  let groundTex = null;
  let initialized = false;

  const show3DError = () => {
    errorElement.hidden = false;
    threeCanvas.hidden = true;

    if (frameId !== null) {
      cancelAnimationFrame(frameId);
      frameId = null;
    }

    if (renderer) {
      renderer.dispose();
      renderer = null;
    }
  };

  const disposeMaterial = (material) => {
    if (Array.isArray(material)) {
      material.forEach((mat) => mat.dispose());
    } else {
      material?.dispose();
    }
  };

  const disposeObject = (object) => {
    object.traverse?.((child) => {
      if (child.isMesh) {
        child.geometry?.dispose();
        disposeMaterial(child.material);
      }
    });
  };

  const cleanup = () => {
    if (frameId !== null) {
      cancelAnimationFrame(frameId);
      frameId = null;
    }

    window.removeEventListener('resize', onWindowResize);

    if (renderer?.domElement) {
      renderer.domElement.removeEventListener(
        'webglcontextlost',
        onWebGLContextLost
      );
    }

    environmentObjects.forEach((object) => {
      scene?.remove(object);
      object.geometry?.dispose();
      disposeMaterial(object.material);
    });

    particles.forEach((particle) => {
      scene?.remove(particle);
      particle.geometry?.dispose();
      disposeMaterial(particle.material);
    });

    if (rover1) {
      disposeObject(rover1);
      scene?.remove(rover1);
      rover1 = null;
    }

    if (rover2) {
      disposeObject(rover2);
      scene?.remove(rover2);
      rover2 = null;
    }

    groundTex?.dispose();

    environmentObjects.length = 0;
    particles.length = 0;

    if (renderer) {
      renderer.dispose();

      if (renderer.domElement.parentNode === threeCanvas) {
        threeCanvas.removeChild(renderer.domElement);
      }

      renderer = null;
    }

    scene = null;
    camera = null;
    groundTex = null;
    initialized = false;
  };

  function onWebGLContextLost(event) {
    event.preventDefault();
    console.error('WebGL context was lost.');
    show3DError();
  }

  function onWindowResize() {
    if (!camera || !renderer) {
      return;
    }

    const width = wrapper.clientWidth;
    const height = wrapper.clientHeight;

    if (width <= 0 || height <= 0) {
      return;
    }

    const aspect = width / height;
    const d = 6;

    camera.left = -d * aspect;
    camera.right = d * aspect;
    camera.top = d;
    camera.bottom = -d;
    camera.updateProjectionMatrix();

    renderer.setSize(width, height, false);
  }

  function createEnvironmentPiece() {
    if (!scene) {
      return;
    }

    const isRock = Math.random() > 0.3;
    const size = 0.2 + Math.random() * 0.6;

    const geo = isRock
      ? new THREE.BoxGeometry(size, size * 0.6, size)
      : new THREE.BoxGeometry(0.2, size * 2, 0.2);

    const color = isRock
      ? new THREE.Color().setHSL(
          0,
          0,
          0.3 + Math.random() * 0.2
        )
      : new THREE.Color().setHSL(
          0.3,
          0.4,
          0.2 + Math.random() * 0.2
        );

    const mat = new THREE.MeshPhongMaterial({ color });
    const mesh = new THREE.Mesh(geo, mat);

    const side = Math.random() > 0.5 ? 1 : -1;
    const x = side * (4 + Math.random() * 6);

    mesh.position.set(
      x,
      isRock ? size / 4 : size,
      20
    );

    mesh.castShadow = true;
    mesh.receiveShadow = true;

    scene.add(mesh);
    environmentObjects.push(mesh);
  }

  function createDirt(rover, xOffset) {
    if (!rover || !scene) {
      return;
    }

    const particle = new THREE.Mesh(
      new THREE.BoxGeometry(0.12, 0.12, 0.12),
      new THREE.MeshPhongMaterial({
        color: 0xa14a2a,
        transparent: true,
        opacity: 0.8
      })
    );

    particle.position.set(
      rover.position.x +
        xOffset +
        (Math.random() * 2 - 1) * 0.1,
      0.1,
      rover.position.z - 1.2
    );

    particle.userData.life = 1.0;

    scene.add(particle);
    particles.push(particle);
  }

  function setupModel(gltf, x, z) {
    if (!scene) {
      return null;
    }

    const model = gltf.scene;

    model.traverse((node) => {
      if (node.isMesh) {
        node.castShadow = true;
        node.receiveShadow = true;
      }
    });

    model.scale.set(1.5, 1.5, 1.5);
    model.rotation.y = 3 * Math.PI / 2;
    model.position.set(x, 0, z);

    scene.add(model);

    return model;
  }

  function initialize() {
    if (initialized) {
      return;
    }

    initialized = true;

    const width = wrapper.clientWidth;
    const height = wrapper.clientHeight;

    if (width <= 0 || height <= 0) {
      initialized = false;

      requestAnimationFrame(() => {
        initialize();
      });

      return;
    }

    try {
      /*
        * 1. Scene
        */
      scene = new THREE.Scene();
      scene.fog = new THREE.Fog(
        0xd4a373,
        15,
        30
      );

      /*
        * 2. Camera
        */
      const aspect = width / height;
      const d = 6;

      camera = new THREE.OrthographicCamera(
        -d * aspect,
        d * aspect,
        d,
        -d,
        1,
        1000
      );

      camera.position.set(10, 10, 10);
      camera.lookAt(0, 0, 0);

      /*
        * 3. Renderer
        *
        * This is now the actual WebGL availability test.
        * If WebGL cannot be initialized, the constructor throws
        * and we display the fallback.
        */
      renderer = new THREE.WebGLRenderer({
        antialias: true,
        alpha: true
      });
      errorElement.hidden = true;
      threeCanvas.hidden = false;

      renderer.setSize(width, height, false);
      renderer.setPixelRatio(
        Math.min(window.devicePixelRatio, 2)
      );

      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type =
        THREE.PCFSoftShadowMap;

      renderer.domElement.addEventListener(
        'webglcontextlost',
        onWebGLContextLost,
        false
      );

      threeCanvas.appendChild(renderer.domElement);

      /*
        * 4. Lighting
        */
      const ambientLight = new THREE.AmbientLight(
        0xffffff,
        0.6
      );

      scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(
        0xffffff,
        1.2
      );

      dirLight.position.set(10, 20, 10);
      dirLight.castShadow = true;

      dirLight.shadow.camera.left = -10;
      dirLight.shadow.camera.right = 10;
      dirLight.shadow.camera.top = 10;
      dirLight.shadow.camera.bottom = -10;

      dirLight.shadow.mapSize.width = 1024;
      dirLight.shadow.mapSize.height = 1024;

      scene.add(dirLight);

      /*
        * 5. Ground
        */
      const groundGeo = new THREE.PlaneGeometry(
        100,
        100
      );

      const canvas = document.createElement('canvas');
      canvas.width = 64;
      canvas.height = 64;

      const ctx = canvas.getContext('2d');

      if (!ctx) {
        throw new Error(
          'Unable to create 2D canvas context.'
        );
      }

      ctx.fillStyle = '#b85c38';
      ctx.fillRect(0, 0, 64, 64);

      ctx.strokeStyle = '#a14a2a';
      ctx.lineWidth = 2;
      ctx.strokeRect(0, 0, 64, 64);

      groundTex = new THREE.CanvasTexture(canvas);
      groundTex.wrapS = THREE.RepeatWrapping;
      groundTex.wrapT = THREE.RepeatWrapping;
      groundTex.repeat.set(40, 40);

      const groundMat =
        new THREE.MeshPhongMaterial({
          map: groundTex
        });

      const ground = new THREE.Mesh(
        groundGeo,
        groundMat
      );

      ground.rotation.x = -Math.PI / 2;
      ground.receiveShadow = true;

      scene.add(ground);

      /*
        * 6. Models
        */
      const loader = new GLTFLoader();

      loader.load(
        '/3d/prairie_pioneer.glb',
        (gltf) => {
          rover1 = setupModel(gltf, -2, 0);
        },
        undefined,
        (error) => {
          console.error(
            'Failed to load prairie_pioneer.glb:',
            error
          );
        }
      );

      loader.load(
        '/3d/project_perry.glb',
        (gltf) => {
          rover2 = setupModel(
            gltf,
            2,
            -1.5
          );
        },
        undefined,
        (error) => {
          console.error(
            'Failed to load project_perry.glb:',
            error
          );
        }
      );

      /*
        * 7. Animation
        */
      let time = 0;

      const animate = () => {
        frameId = requestAnimationFrame(
          animate
        );

        if (!renderer || !scene || !camera) {
          return;
        }

        time += 0.05;

        if (groundTex) {
          groundTex.offset.y -=
            scrollSpeed / 2.5;
        }

        [rover1, rover2].forEach((rover, i) => {
          if (!rover) {
            return;
          }

          rover.position.y =
            Math.abs(
              Math.sin(time * 0.3 + i)
            ) * 0.12;

          rover.position.z +=
            Math.sin(time * 0.3 + i) * 0.01;

          rover.rotation.x =
            Math.sin(time * 0.3 + i) * -0.02;

          rover.position.x +=
            (Math.random() - 0.5) * 0.02;

          rover.position.x =
            THREE.MathUtils.lerp(
              rover.position.x,
              i === 0 ? -2 : 2,
              0.1
            );

          if (Math.random() > 0.8) {
            createDirt(rover, -0.6);
            createDirt(rover, 0.6);
          }
        });

        /*
          * Environment
          */
        if (Math.random() > 0.96) {
          createEnvironmentPiece();
        }

        for (
          let i = environmentObjects.length - 1;
          i >= 0;
          i--
        ) {
          const object =
            environmentObjects[i];

          object.position.z -= scrollSpeed;

          if (object.position.z < -20) {
            scene.remove(object);
            environmentObjects.splice(i, 1);

            object.geometry.dispose();
            disposeMaterial(object.material);
          }
        }

        /*
          * Dirt
          */
        for (
          let i = particles.length - 1;
          i >= 0;
          i--
        ) {
          const particle =
            particles[i];

          particle.position.z -=
            scrollSpeed * 0.8;

          particle.position.y += 0.01;
          particle.userData.life -= 0.02;

          particle.scale.setScalar(
            particle.userData.life
          );

          if (
            particle.userData.life <= 0
          ) {
            scene.remove(particle);
            particles.splice(i, 1);

            particle.geometry.dispose();
            disposeMaterial(
              particle.material
            );
          }
        }

        renderer.render(
          scene,
          camera
        );
      };

      animate();

      window.addEventListener(
        'resize',
        onWindowResize
      );
    } catch (error) {
      console.error(
        'Failed to initialize 3D renderer:',
        error
      );

      cleanup();
      show3DError();
    }
  }

  /*
    * Astro lifecycle:
    * Initialize after the current page has been rendered.
    */
  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      initialize,
      { once: true }
    );
  } else {
    initialize();
  }

  /*
    * Astro client-side navigation.
    */
  document.addEventListener(
    'astro:before-swap',
    cleanup,
    { once: true }
  );
});
</script>

<style>
.voxel-wrapper {
  position: relative;

  width: 100%;
  height: clamp(200px, 45vw, 400px);

  overflow: hidden;
}

.voxel-container {
  width: 100%;
  height: 100%;

  display: flex;
  align-items: center;
  justify-content: center;

  pointer-events: none;
}

.voxel-container canvas {
  display: block;

  width: 100%;
  height: 100%;
}

.voxel-error[hidden] {
  display: none !important;
}

.voxel-error {
  width: 100%;
  height: 100%;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 2rem;

  box-sizing: border-box;
}

.voxel-error-content {
  max-width: 28rem;

  text-align: center;
}

.voxel-error-content h2 {
  margin: 0 0 0.5rem;

  font-size: 1.25rem;
  font-weight: 700;
}

.voxel-error-content p {
  margin: 0;

  color: #666;

  line-height: 1.5;
}
</style>
