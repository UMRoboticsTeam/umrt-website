---
import Hero from './Hero.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description?: string;
  image?: string | ImageMetadata;
}

const {
  title,
  description,
  image,
} = Astro.props;

const imageSrc = image && typeof image !== 'string'
  ? (await getImage({ src: image, width: 1920, format: 'webp' })).src
  : image;
---

<Hero
  title={title}
  subtitle={description}
  imgSrc={imageSrc}
/>
