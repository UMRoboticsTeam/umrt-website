---
interface Props {
  title: string;
  imgSrc: string;
  backgroundPosition?: string;
}

const { title, imgSrc, backgroundPosition = "center" } = Astro.props;
---

<div
  class="masthead"
  style={`
    background:
      linear-gradient(
        to bottom,
        rgba(99, 109, 128, 0.7) 0%,
        rgba(52, 58, 69, 0.9) 95%,
        rgba(52, 58, 69, 1) 100%
      ),
      url(${imgSrc});
    background-position: ${backgroundPosition};
    background-repeat: no-repeat;
    background-size: cover;
    background-attachment: scroll;
  `}
>
  <div class="container px-4 px-lg-5 h-80">
    <div class="row gx-4 gx-lg-5 h-100 align-items-center justify-content-center text-center">
    </div>
  </div>
</div>

<div class="mastheadHolder">
  <div class="container px-4 px-lg-5 h-80">
    <div class="row gx-4 gx-lg-5 h-100 align-items-center justify-content-center text-center">

      <div>
        <h1 class="title">{title}</h1>
        <slot />
      </div>

    </div>
  </div>
</div>

<script>
  function parallax() {
    const masthead = document.querySelector<HTMLElement>(".masthead");

    if (!masthead) return;

    const yPos = -window.scrollY / 3;
    masthead.style.top = `${yPos}px`;
  }

  parallax();
  window.addEventListener("scroll", parallax);
</script>

<style>
  .masthead {
    height: 100vh;
    display: flex;
    justify-content: center;

    position: fixed;
    width: 100%;
    z-index: -1;
  }

  .mastheadHolder {
    height: 100vh;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .title {
    color: white;
    font-size: 3rem;
    font-weight: bold;
    text-shadow: 0.09em 0.09em #063260;
  }
</style>