---
interface Props {
  title?: string;
  subtitle?: string;
  imgSrc?: string;
  backgroundPosition?: string;
}

const {
  title = '',
  subtitle,
  imgSrc,
  backgroundPosition = 'center'
} = Astro.props;

const image = imgSrc ? `url(${imgSrc})` : 'none';
---

<section
  class="hero"
  style={`--hero-image:${image}; background-position:${backgroundPosition};`}
>
  <div class="container hero-content">
    <h1>{title}</h1>

    {subtitle && <p>{subtitle}</p>}

    <slot />
  </div>
</section>