---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Member {
  name: string;
  role: string;
  image: ImageMetadata;
  href?: string;
}

interface Props {
  member: Member;
}

const { member } = Astro.props;
const isLinked = Boolean(member.href);
---

{
  isLinked ? (
    <a
      class="member-card"
      href={member.href}
      target="_blank"
      rel="noopener noreferrer"
    >
      <div class="member-image">
        <Image
          src={member.image}
          alt={member.name}
          widths={[300, 500]}
          sizes="(max-width: 700px) 42vw, 220px"
          loading="lazy"
        />
      </div>

      <div class="member-content">
        <h3 class="member-name">{member.name}</h3>

        <div class="member-role">
          {member.role}
        </div>
      </div>
    </a>
  ) : (
    <article class="member-card">
      <div class="member-image">
        <Image
          src={member.image}
          alt={member.name}
          widths={[300, 500]}
          sizes="(max-width: 700px) 42vw, 220px"
          loading="lazy"
        />
      </div>

      <div class="member-content">
        <h3 class="member-name">{member.name}</h3>

        <div class="member-role">
          {member.role}
        </div>
      </div>
    </article>
  )
}

<style>
  .member-card {
    /*
     * Desktop:
     * Allows four cards to comfortably fit while preventing them
     * from becoming excessively large.
     */
    width: clamp(150px, 19vw, 225px);
    flex: 0 0 clamp(150px, 19vw, 225px);

    /*
     * Keeps every card the exact same height regardless of
     * name/role length.
     */
    aspect-ratio: 1 / 1.55;

    display: flex;
    flex-direction: column;

    overflow: hidden;

    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;

    background: var(--umrt-navy);

    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.16);

    color: inherit;
    text-decoration: none;

    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease;
  }

  a.member-card {
    cursor: pointer;
  }

  .member-card:hover {
    transform: translateY(-4px);

    border-color: rgba(255, 255, 255, 0.28);

    box-shadow:
      0 14px 30px rgba(0, 0, 0, 0.24);
  }

  .member-image {
    /*
     * Identical image region on every card.
     */
    flex: 0 0 70%;
    min-height: 0;

    overflow: hidden;

    background: #111;
  }

  .member-image :global(img) {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .member-content {
    /*
     * Remaining card space is always identical because the card
     * itself has a fixed aspect ratio.
     */
    flex: 1;

    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;

    padding: 0.8rem;
  }

  .member-name {
    /*
     * The name is intentionally a one-line field.
     */
    width: 100%;
    min-height: 1.2em;

    margin: 0;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    color: #fff;

    font-size: clamp(0.82rem, 1.4vw, 1.05rem);
    line-height: 1.2;
    font-weight: 800;

    text-align: center;
  }

  .member-role {
    /*
     * Reserve enough vertical space for TWO lines even when the
     * actual role only occupies one line.
     *
     * This is the important part for keeping all cards uniform.
     */
    min-height: 2.5em;

    display: flex;
    align-items: flex-start;
    justify-content: center;

    width: 100%;
    margin-top: 0.45rem;

    color: #8fb7b7;

    font-size: clamp(0.62rem, 1.1vw, 0.76rem);
    line-height: 1.25;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;

    text-align: center;
  }

  @media (max-width: 700px) {
    .member-card {
      /*
       * EXACTLY two cards can fit in the available width.
       *
       * The parent centers the whole row, so a final single card
       * is centered automatically.
       */
      width: calc((100% - 0.75rem) / 2);
      flex-basis: calc((100% - 0.75rem) / 2);

      max-width: 190px;
    }

    .member-content {
      padding: 0.6rem;
    }

    .member-name {
      font-size: 0.8rem;
    }

    .member-role {
      font-size: 0.62rem;
    }
  }

  @media (max-width: 360px) {
    .member-card {
      /*
       * Keep two columns even on very narrow phones.
       */
      width: calc((100% - 0.5rem) / 2);
      flex-basis: calc((100% - 0.5rem) / 2);
    }

    .member-content {
      padding: 0.5rem;
    }

    .member-name {
      font-size: 0.74rem;
    }

    .member-role {
      font-size: 0.57rem;
    }
  }
</style>
